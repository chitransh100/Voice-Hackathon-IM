# Copy to .env and replace both placeholders before running anything.
# Every service must load this same file and use this same absolute database path.
# Never commit the populated .env file.
VANI_SERVICE_TOKEN=replace-with-one-random-secret-at-least-16-characters
VANI_DB_PATH=/absolute/path/to/extracted/submission/Context/data/vani.sqlite

VANI_HTTP_ADDR=127.0.0.1:18080
VANI_LOOKUP_HTTP_ADDR=127.0.0.1:18081
VANI_PROFILE_HTTP_ADDR=127.0.0.1:18082
VANI_ENRICHMENT_HTTP_ADDR=127.0.0.1:18083

VANI_TIMEZONE=Asia/Kolkata
VANI_DB_BUSY_TIMEOUT_MS=5000
VANI_RECENT_HISTORY_DAYS=15
VANI_CONTEXT_TOKEN_BUDGET=900
VANI_WORKER_INTERVAL_MS=2000
VANI_LOOKUP_CANDIDATE_LIMIT=500

# Tests/replay only. Leave unset in a live run so UTC now is used.
# VANI_REFERENCE_TIME=2026-10-10T00:00:00.000Z
